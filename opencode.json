{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ai-box": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AI Box",
      "options": {
        "baseURL": "https://api.ai-box.vn/v1",
        "apiKey": "sk-HHbW8DLytkZtrz9UlHmbX3lhsXqS3mhoWZnX5PBH1dulT9He"
      },
      "models": {
        "deepseek-v4-flash-0731": {
          "name": "DS4 Flash 0731",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "deepseek-v4-flash": {
          "name": "DS4 Old",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "qwen3.8-max": {
          "name": "Qwen 3.8 Max",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "qwen3.8-flash": {
          "name": "Qwen3.8-flash",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "ZHIPU/GLM-5.3": {
          "name": "GLM 5.3 Box",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code",
          "limit": {
            "context": 256000,
            "output": 8192
          }
        }
      }
    }
  },
  "instructions": [
    "~/.claude/CLAUDE.md"
  ],
  "plugin": [
    "./plugins/dictation-suffix.ts",
    "@openchamber/opencode-claude@0.14.0",
    "@openchamber/opencode-cursor@2.5.1"
  ],
  "lsp": false,
  "agent": {
    "build": {
      "mode": "primary",
      "prompt": "",
      "permission": {
        "*": "deny",
        "read": {
          "*.md": "allow"
        },
        "task": "allow",
        "question": "allow",
        "skill": "allow",
        "external_directory": "allow",
        "todowrite": "allow",
        "plan_enter": "allow",
        "plan_exit": "allow",
        "openchamber": "deny",
        "openchamber_web": "deny"
      },
      "description": "The default agent. Executes tools based on configured permissions."
    },
    "plan": {
      "disable": true
    },
    "explore": {
      "disable": false
    },
    "general": {
      "disable": false
    }
  },
  "mcp": {
    "zai-mcp-server": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@z_ai/mcp-server"
      ],
      "environment": {
        "Z_AI_API_KEY": "ccfe7d0bdb2743278671eac7888d4fbd.Wrg7ZJd6GSEzzPv8",
        "Z_AI_MODE": "ZAI"
      },
      "enabled": false
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  }
}