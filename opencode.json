{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ai-box": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AI Box",
      "options": {
        "baseURL": "https://api.ai-box.vn/v1",
        "apiKey": "sk-HHbW8DLytkZtrz9UlHmbX3lhsXqS3mhoWZnX5PBH1dulT9He"
      },
      "models": {
        "ZHIPU/GLM-5.3": {
          "name": "GLM 5.3 Box",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "ds/deepseek-flash": {
          "name": "DS Flash",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        }
      }
    }
  },
  "instructions": [
    "~/.claude/CLAUDE.md",
    "~/.config/opencode/AGENTS.md"
  ],
  "plugin": [
    "@openchamber/opencode-claude"
  ],
  "lsp": false,
  "agent": {
    "build": {
      "mode": "primary",
      "prompt": "",
      "permission": {
        "*": "deny",
        "read": {
          "*.md": "allow",
          "*.png": "allow",
          "*.jpg": "allow",
          "*.jpeg": "allow",
          "*.gif": "allow",
          "*.svg": "allow",
          "*.webp": "allow"
        },
        "task": "allow",
        "question": "allow",
        "skill": "allow",
        "external_directory": "allow",
        "todowrite": "allow",
        "plan_enter": "allow",
        "plan_exit": "allow",
        "openchamber": "deny",
        "openchamber_web": "deny"
      },
      "description": "The default agent. Executes tools based on configured permissions."
    },
    "plan": {
      "disable": true
    },
    "explore": {
      "disable": false
    },
    "general": {
      "disable": false
    }
  },
  "mcp": {
    "zai-mcp-server": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@z_ai/mcp-server"
      ],
      "environment": {
        "Z_AI_API_KEY": "ccfe7d0bdb2743278671eac7888d4fbd.Wrg7ZJd6GSEzzPv8",
        "Z_AI_MODE": "ZAI"
      },
      "enabled": false
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "penpot": {
      "type": "remote",
      "url": "https://design.penpot.app/mcp/stream?userToken=eyJhbGciOiJBMjU2S1ciLCJlbmMiOiJBMjU2R0NNIn0.GdKzz1Dn2FocZz7deBNlF-e5qrnPYRHf5qSOtnGJB_1jWVV3zaUcFg.Bhu6-b0vqVVX06oS.-vTycUC1-lKOUk_UxZpPd_tp0taGFkvrKUuKPtKG5-6p_fD7sMrPcNuQd_P7d3LKQeNwdqVnKHvIro1CqqHLj3TrDfZfZNgXy6SCYhzg6NK1s9f7P4A20UxB7_IuRmqcGPct_fUN_DYH9j72P1B_fVIMhP5Fecq869jTjv5wsdN4P1HF2AcGqeKAKq10R1EYn6PWq5jIivK7.hw_XsmmkSod2UyUhDyafjA",
