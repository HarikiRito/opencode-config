{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.claude/CLAUDE.md",
    "AGENTS.md"
  ],
  "plugin": [],
  "lsp": false,
  "agent": {
    "build": {
      "mode": "primary",
      "prompt": "orchestrator. read allowed on *.md only (enforced). no edit/write/bash/grep/glob/list/webfetch — ever. all other work → task delegate to a subagent.",
      "permission": {
        "*": "deny",
        "read": {
          "*.md": "allow",
          "*": "deny"
        },
        "task": "allow"
      }
    },
    "plan": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "mcp": {
    "zai-mcp-server": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@z_ai/mcp-server"
      ],
      "environment": {
        "Z_AI_API_KEY": "ccfe7d0bdb2743278671eac7888d4fbd.Wrg7ZJd6GSEzzPv8",
        "Z_AI_MODE": "ZAI"
      },
      "enabled": false
    }
  }
}
